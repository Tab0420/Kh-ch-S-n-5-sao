@model IEnumerable<Khách_Sạn_5_sao.Models.Room>
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Phòng trống";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";

    DateTime start = ViewBag.CheckIn;
    DateTime end = ViewBag.CheckOut;
    DateTime today = ViewBag.Today;

    var names = ViewBag.RoomNames as IDictionary<string, string>
        ?? new Dictionary<string, string>();

    var photos = ViewBag.RoomPhotos as IDictionary<string, string>
        ?? new Dictionary<string, string>();

    string fallback =
        "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=800&q=80";

    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<link rel="stylesheet" href="@Url.Content("~/Content/StyleĐP.css")?v=2" />

<div class="booking-room-page">

    <div class="room-intro">
        <h2>Chọn phòng trống</h2>
        <p>
            Chọn ngày lưu trú và loại phòng.
            Kết quả chỉ gồm phòng còn trống trong cả khoảng ngày bạn chọn.
        </p>
    </div>

    @using (Html.BeginForm(
        "Index", "Bookings", FormMethod.Get,
        new
        {
            style = "display:flex;flex-wrap:wrap;gap:16px;padding:20px;" +
                    "background:white;border:1px solid #e6e1ed;" +
                    "border-radius:12px;margin-bottom:24px;align-items:end;"
        }))
    {
        <label style="flex:1;min-width:180px;">
            Ngày nhận phòng
            <input type="date"
                   name="ngay_checkin"
                   value="@start.ToString("yyyy-MM-dd")"
                   min="@today.ToString("yyyy-MM-dd")"
                   required
                   style="display:block;width:100%;padding:10px;border:1px solid #ccc;border-radius:6px;" />
        </label>

        <label style="flex:1;min-width:180px;">
            Ngày trả phòng
            <input type="date"
                   name="ngay_checkout"
                   value="@end.ToString("yyyy-MM-dd")"
                   min="@start.AddDays(1).ToString("yyyy-MM-dd")"
                   required
                   style="display:block;width:100%;padding:10px;border:1px solid #ccc;border-radius:6px;" />
        </label>

        <label style="flex:1;min-width:180px;">
            Loại phòng
            @Html.DropDownList(
                "type_id",
                (SelectList)ViewBag.RoomTypes,
                "Tất cả loại phòng",
                new
                {
                    style = "display:block;width:100%;padding:10px;" +
                            "border:1px solid #ccc;border-radius:6px;"
                }
            )
        </label>

        <button type="submit"
                class="room-button"
                style="border:0;cursor:pointer;">
            Tìm phòng trống
        </button>
    }

    @Html.ValidationSummary(
        false, "",
        new { style = "color:#b62e51;margin-bottom:20px;", role = "alert" }
    )

    @if (TempData["RoomMessage"] != null)
    {
        <p role="alert">@TempData["RoomMessage"]</p>
    }

    @if (!Model.Any() && ViewData.ModelState.IsValid)
    {
        <p role="status"
           style="padding:24px;background:white;border-radius:12px;">
            Không còn phòng trống phù hợp.
            Vui lòng đổi ngày hoặc chọn loại phòng khác.
        </p>
    }

    @foreach (var group in Model.GroupBy(r => r.Room_Types))
    {
        <section style="margin-bottom:32px;">
            <h2 style="font-size:24px;color:#563477;margin-bottom:16px;">
                @group.Key.ten_loai
                <small style="font-size:16px;font-weight:400;">
                    — @group.Count() phòng trống
                </small>
            </h2>

            <div class="room-list-items">
                @foreach (var room in group)
                {
                    string name = names.ContainsKey(room.room_id)
                        ? names[room.room_id]
                        : "Phòng nghỉ";

                    string photo = photos.ContainsKey(room.room_id)
                        && !string.IsNullOrWhiteSpace(photos[room.room_id])
                        ? photos[room.room_id]
                        : fallback;

                    <article class="room-detail-card"
                             data-room-id="@room.room_id"
                             data-type-id="@room.type_id">

                        <div class="room-image">
                            <span aria-hidden="true">Ảnh phòng đang cập nhật</span>

                            <img src="@photo"
                                 alt="@name"
                                 loading="lazy"
                                 decoding="async"
                                 data-fallback="@fallback"
                                 onerror="if (!this.dataset.failed) { this.dataset.failed='1'; this.src=this.dataset.fallback; } else { this.hidden=true; }" />
                        </div>

                        <div class="room-content">
                            <h3>@name</h3>
                            <p>@room.Room_Types.ten_loai</p>

                            <p class="room-price">
                                @room.Room_Types.gia_tien.Value.ToString("N0", culture)đ / đêm
                            </p>

                            <div class="room-amenities">
                                <span>
                                    Tối đa @(room.Room_Types.suc_chua ?? 2) khách
                                </span>
                                <span>
                                    Diện tích:
                                    @(room.Room_Types.dien_tich ?? "Đang cập nhật")
                                </span>
                                <span>
                                    @(room.Room_Types.giuong ?? "Đang cập nhật giường")
                                </span>
                                <span>
                                    @(room.Room_Types.view_phong ?? "Đang cập nhật hướng phòng")
                                </span>
                            </div>

                            <p style="margin-bottom:16px;">
                                @room.Room_Types.tien_nghi
                            </p>

                            <a class="room-button"
                               href="@Url.Action("Reserve", "Bookings", new {
                                   room_id = room.room_id,
                                   ngay_checkin = start.ToString("yyyy-MM-dd"),
                                   ngay_checkout = end.ToString("yyyy-MM-dd")
                               })">
                                Đặt phòng này
                            </a>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

<script>
    document.querySelector('input[name="ngay_checkin"]')
        .addEventListener('change', function () {
            const checkout = document.querySelector(
                'input[name="ngay_checkout"]'
            );

            if (!this.value) return;

            const next = new Date(this.value + 'T00:00:00Z');
            next.setUTCDate(next.getUTCDate() + 1);

            checkout.min = next.toISOString().slice(0, 10);

            if (!checkout.value || checkout.value <= this.value) {
                checkout.value = checkout.min;
            }
        });
</script>