@model Khách_Sạn_5_sao.Models.Booking

@{
    ViewBag.Title = "Xác Nhận Xóa Đơn" + Model.booking_id;
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
    }

    .bg-purple {
        background-color: #5c3c92 !important;
    }
</style>

<div class="container my-5" style="max-width: 650px;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden border-danger">

        <div class="card-header bg-danger text-white p-4 text-center">
            <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-2"></i>
            <h4 class="mb-0 fw-bold">XÁC NHẬN XÓA ĐƠN ĐẶT PHÒNG #@Model.booking_id</h4>
        </div>

        <div class="card-body p-4 bg-white text-center">
            <p class="text-secondary fs-6 mb-4">
                Bạn có chắc chắn muốn xóa đơn đặt phòng này khỏi hệ thống không?<br />
                <strong class="text-danger">Hành động này không thể hoàn tác!</strong>
            </p>

            <!-- BẢNG TÓM TẮT ĐƠN XÓA -->
            <div class="p-3 bg-light rounded-3 border text-start mb-4 small">
                <div class="row g-2">
                    <div class="col-6"><strong>Khách hàng:</strong> @(Model.User != null ? Model.User.ho_ten : "N/A")</div>
                    <div class="col-6"><strong>Số điện thoại:</strong> @(Model.User != null ? Model.User.so_dien_thoai : "N/A")</div>
                    <div class="col-6"><strong>Check-in:</strong> @(Model.ngay_checkin.HasValue ? Model.ngay_checkin.Value.ToString("dd/MM/yyyy") : "--")</div>
                    <div class="col-6"><strong>Check-out:</strong> @(Model.ngay_checkout.HasValue ? Model.ngay_checkout.Value.ToString("dd/MM/yyyy") : "--")</div>
                    <div class="col-12 mt-2 pt-2 border-top">
                        <strong class="text-danger">Tổng tiền thanh toán: @((Model.tong_tien ?? 0).ToString("N0")) VNĐ</strong>
                    </div>
                </div>
            </div>

            @using (Html.BeginForm("Delete", "Bookings", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.booking_id)

                <div class="d-flex justify-content-center gap-3">
                    <a href="@Url.Action("Index", "Bookings")" class="btn btn-secondary px-4 py-2 fw-bold rounded-3">
                        <i class="bi bi-x-circle me-1"></i> Hủy Bỏ
                    </a>
                    <button type="submit" class="btn btn-danger px-4 py-2 fw-bold rounded-3 shadow">
                        <i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa
                    </button>
                </div>
            }
        </div>
    </div>
</div>