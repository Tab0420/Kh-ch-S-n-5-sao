@using System.Collections.Generic
@using Khách_Sạn_5_sao.Controllers
@{
    var residentBenefits =
        ViewBag.ResidentBenefits as IEnumerable<ResidentServicesController.ServiceRow>;
    var roomOrder = ViewData.Model as MyBookingsController.LookupPage;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title-MoonLight Hotel</title>
    <link rel="stylesheet" href="~/Content/Mystyle.css" />
    <link rel="stylesheet" href="~/Content/stylepro.css" />

    <style>
        .resident-callout {
            max-width: 1040px;
            margin: 24px auto;
            padding: 20px;
            border: 1px solid #e6e1ed;
            border-radius: 10px;
            background: #fff;
            color: #303344;
        }

            .resident-callout h2 {
                color: #5c3c92;
                font-size: 22px;
                margin: 0 0 12px;
            }

            .resident-callout ul {
                display: flex;
                flex-wrap: wrap;
                gap: 12px 24px;
                padding-left: 20px;
            }

            .resident-callout a {
                display: inline-block;
                background: #5c3c92;
                color: #fff;
                padding: 10px 16px;
                border-radius: 6px;
                text-decoration: none;
            }

        .hotel-nav > a,
        .hotel-nav .menu-item > a,
        .hotel-header .booking-btn {
            white-space: nowrap;
        }

        @@media(max-width:1440px) {
            .hotel-header {
                height: auto;
                flex-wrap: wrap;
                gap: 12px;
                padding: 12px 20px;
            }

            .hotel-nav {
                order: 3;
                width: 100%;
                flex-wrap: wrap;
                justify-content: center;
                margin: 0;
            }
        }

        @@media(max-width:576px) {
            .hotel-logo-img {
                width: 64px;
                height: 48px;
            }

            .hotel-logo h2 {
                font-size: 16px;
            }

            .hotel-header .booking-btn {
                padding: 8px 10px;
            }

            .banner-content h1 {
                font-size: 32px;
            }

            .banner-content p {
                font-size: 18px;
                letter-spacing: 2px;
            }

            .my-bookings {
                scroll-margin-top: 280px;
            }
        }
    </style>
</head>
<body>
    <header class="hotel-header">
        <div class="hotel-logo">
            <a href="@Url.Action("TrangChu","Home")">
                <img src="~/images/moon.png" alt="Moonlight Hotel"
                     class="hotel-logo-img" />
                <h2>MOONLIGHT HOTEL</h2>
            </a>
        </div>

        <nav class="hotel-nav" aria-label="Menu chính">
            <a href="#" id="btnGioiThieu">GIỚI THIỆU</a>

            <div class="menu-item">
                <a href="@Url.Action("PhongNghi","Home")">PHÒNG NGHỈ</a>
                <div class="dropdown-menu">
                    <a href="@Url.Action("Index","Bookings",new { loaiPhong="Superior" })">Phòng Superior</a>
                    <a href="@Url.Action("Index","Bookings",new { loaiPhong="Deluxe" })">Phòng Deluxe</a>
                    <a href="@Url.Action("Index","Bookings",new { loaiPhong="HuongBien" })">Phòng Hướng Biển</a>
                    <a href="@Url.Action("Index","Bookings",new { loaiPhong="GiaDinh" })">Phòng Gia Đình</a>
                    <a href="@Url.Action("Index","Bookings",new { loaiPhong="Suite" })">Phòng Suite</a>
                    <a href="@Url.Action("Index","Bookings",new { loaiPhong="CaoCap" })">Phòng Cao Cấp</a>
                </div>
            </div>

            <div class="menu-item">
                @Html.ActionLink("TIỆN ÍCH", "TienIch", "Home")
                <div class="dropdown-menu">
                    <a href="@Url.Action("Index","Dining",new { group="WELLNESS",serviceCode="POOL",open=1 })">Hồ Bơi</a>
                    <a href="@Url.Action("Index","Dining",new { group="WELLNESS",serviceCode="GYM",open=1 })">Phòng GYM</a>
                    <a href="@Url.Action("Index","Dining",new { group="WELLNESS" })">SPA &amp; Thư Giãn</a>
                    <a href="@Url.Action("Index","Dining",new { group="WELLNESS",serviceCode="YOGA",open=1 })">Yoga cùng HLV</a>
                    <a href="#">Bữa Ăn Tại Phòng</a>
                    <a href="#">Không Gian Nghỉ Dưỡng</a>
                    <a href="#">Không Gian Sự Kiện</a>
                </div>
            </div>

            <div class="menu-item">
                @Html.ActionLink("DỊCH VỤ", "DichVu", "Home")
                <div class="dropdown-menu">
                    <a href="@Url.Action("Index","Bookings")">Đặt phòng</a>
                    <a href="@Url.Action("Index","Dining",new { group="WELLNESS" })">Thư giãn &amp; Sức khỏe</a>
                    <a href="@Url.Action("Index","Dining",new { group="DINING" })">Nhà hàng &amp; Ẩm thực</a>
                    <a href="@Url.Action("Index","ResidentServices")">Dịch vụ khách lưu trú</a>
                    <a href="#">Thể Thao &amp; Giải Trí</a>
                    <a href="#">Hỗ Trợ Khách Hàng</a>
                    <a href="#">Tiệc &amp; Sự Kiện</a>
                </div>
            </div>

            @Html.ActionLink("LIÊN HỆ", "Contact", "Home")

            <div class="menu-item">
                @Html.ActionLink("ƯU ĐÃI", "UuDai", "Home")
            </div>

            <div class="menu-item">
                <a href="@Url.Action("Index","MyBookings")#my-bookings">ĐƠN ĐÃ ĐẶT</a>
                <div class="dropdown-menu">
                    <a href="@Url.Action("Index","MyBookings")#my-bookings">Đơn đặt phòng</a>
                    <a href="@Url.Action("Lookup","Dining")">Đơn ăn uống &amp; dịch vụ</a>
                </div>
            </div>
        </nav>

        @Html.ActionLink("ĐẶT PHÒNG", "Index", "Bookings",
            null, new { @class = "booking-btn" })
    </header>

    <div class="intro-box" id="khungGioiThieu">
        <div class="intro-header">
            <h2>KHÁCH SẠN MOONLIGHT HOTEL</h2>
            <button type="button" id="btnDong">&times;</button>
        </div>
        <div class="intro-content">
            <h3>Lịch sử hình thành và phát triển</h3>
            <p>
                Moonlight Hotel hướng đến việc mang đến cho khách hàng
                không gian nghỉ dưỡng thoải mái, tiện nghi và những
                trải nghiệm lưu trú đáng nhớ.
            </p>
            <h3>Không gian nghỉ dưỡng</h3>
            <p>
                Với phong cách thiết kế hiện đại, không gian ấm cúng
                và hệ thống phòng nghỉ tiện nghi, khách sạn mong muốn
                đáp ứng nhu cầu nghỉ dưỡng của nhiều đối tượng khách hàng.
            </p>
            <h3>Dịch vụ của khách sạn</h3>
            <p>
                Moonlight Hotel cung cấp các tiện ích và dịch vụ hỗ trợ
                khách hàng, hướng đến sự thoải mái và thuận tiện
                trong suốt thời gian lưu trú.
            </p>
            <h3>Sứ mệnh</h3>
            <p>
                Chúng tôi mong muốn mang đến sự hài lòng, dịch vụ chu đáo
                và những kỷ niệm đáng nhớ trong mỗi chuyến đi.
            </p>
        </div>
    </div>

    <section class="hotel-banner">
        <div class="banner">
            <img src="~/images/nha trang.jpg" alt="MOONLIGHT HOTEL" />
        </div>
        <div class="banner-content">
            <h1>MOONLIGHT HOTEL</h1>
            <p>Trải nghiệm nghỉ dưỡng tuyệt vời bên bờ biển</p>
        </div>
    </section>

    <div id="div-content">
        @if (residentBenefits != null)
        {
            <aside class="resident-callout">
                <h2>Ưu đãi dịch vụ dành cho khách lưu trú</h2>

                <ul>
                    @foreach (var benefit in residentBenefits)
                    {
                        <li>
                            @benefit.Name:
                            <strong>
                                @(benefit.Price == 0
                                    ? "Miễn phí"
                                    : benefit.Price.ToString(
                                        "N0",
                                        System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
                                        + " đ/người")
                            </strong>
                        </li>
                    }
                </ul>

                <p>
                    Sau khi đặt phòng, bạn được chuyển sang trang chọn lịch dịch vụ.
                    Ưu đãi áp dụng khi đơn phòng đã xác nhận và đối soát tiền.
                    Dịch vụ trả phí được thanh toán riêng;
                    hồ bơi/GYM vẫn cần chọn lịch để kiểm tra chỗ.
                </p>
            </aside>
        }

        @RenderBody()

        @if (roomOrder != null && roomOrder.Order != null)
        {
            <aside class="resident-callout">
                <h2>Dịch vụ ưu đãi theo đơn phòng của bạn</h2>
                <p>
                    Xem giá khách lưu trú, chọn ngày, giờ
                    và số người sử dụng dịch vụ.
                </p>
                <a href="@Url.Action("Index","ResidentServices",new { id=roomOrder.BookingId })#resident-services">
                    Đặt dịch vụ khách lưu trú
                </a>
            </aside>
        }
    </div>

    <footer class="hotel-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <a href="@Url.Action("TrangChu","Home")" class="footer-logo">
                    MOONLIGHT HOTEL
                </a>
                <p>Trải nghiệm nghỉ dưỡng tuyệt vời bên bờ biển.</p>
            </div>

            <div class="footer-column">
                <h3>LIÊN HỆ VỚI CHÚNG TÔI</h3>
                <div class="footer-line"></div>
                <p>ĐT: XXX 123 456</p>
                <p>Email: moonlighthotel@gmail.com</p>
                <p>Địa chỉ: Nha Trang, Khánh Hòa</p>

                <div class="footer-social">
                    <a href="#" title="Facebook">f</a>
                    <a href="#" title="Instagram">◎</a>
                    <a href="#" title="TikTok">♪</a>
                </div>
            </div>

            <div class="footer-column">
                <h3>LIÊN KẾT HỮU ÍCH</h3>
                <div class="footer-line"></div>
                <a href="@Url.Action("TrangChu","Home")">Trang chủ</a>
                <a href="@Url.Action("Index","Dining",new { group="DINING" })">Nhà hàng &amp; Ẩm thực</a>
                <a href="@Url.Action("Index","Dining",new { group="WELLNESS" })">Thư giãn &amp; Sức khỏe</a>
                <a href="@Url.Action("Index","MyBookings")#my-bookings">Đơn đặt phòng của tôi</a>
                <a href="@Url.Action("Lookup","Dining")">Đơn dịch vụ của tôi</a>
                <a href="#">Chính sách bảo mật</a>
                <a href="#">Điều khoản sử dụng</a>
            </div>

            <div class="footer-column">
                <h3>BẢN TIN</h3>
                <div class="footer-line"></div>
                <p>ĐĂNG KÝ NHẬN TIN MỚI</p>
                <form class="footer-form">
                    <input type="email" placeholder="Nhập địa chỉ email..."
                           aria-label="Địa chỉ email" required />
                    <button type="submit">Đăng ký</button>
                </form>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 Moonlight Hotel. All rights reserved.</p>
        </div>

        <a href="#" class="back-to-top" aria-label="Lên đầu trang">⌃</a>
    </footer>

    <script>
        const btnGioiThieu = document.getElementById("btnGioiThieu");
        const khungGioiThieu = document.getElementById("khungGioiThieu");
        const btnDong = document.getElementById("btnDong");

        btnGioiThieu.addEventListener("click", function (event) {
            event.preventDefault();
            khungGioiThieu.style.display =
                khungGioiThieu.style.display === "block" ? "none" : "block";
        });

        btnDong.addEventListener("click", function () {
            khungGioiThieu.style.display = "none";
        });
    </script>
</body>
</html>