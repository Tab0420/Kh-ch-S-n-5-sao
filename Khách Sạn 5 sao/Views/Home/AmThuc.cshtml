
@{
    ViewBag.Title = "AmThuc";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}
<link rel="stylesheet" href="~/Content/StyleAT.css" />
<div class="food-page">

    <section class="food-banner">
        <div>
            <h1>Ẩm Thực</h1>
            <p>Hương vị tinh tế – Trải nghiệm đáng nhớ</p>
        </div>
    </section>

    <section class="food-intro">
        <h2>Khám Phá Thế Giới Ẩm Thực</h2>
        <p>
            Hãy cùng HotelBooking khám phá những trải nghiệm ẩm thực
            hấp dẫn trong không gian sang trọng và ấm cúng.
            Từ món ăn truyền thống Việt Nam đến những món ngon quốc tế,
            mỗi bữa ăn đều góp phần làm cho kỳ nghỉ thêm trọn vẹn.
        </p>
    </section>

    <section class="food-list">

        <div class="food-card">
            <img src="https://www.bepxuadanang.com/wp-content/uploads/2023/10/3717671132780678983135936271886528959611528n.jpg"
                 alt="Ẩm thực Việt Nam" />
            <div class="food-content">
                <div class="food-label">Hương vị truyền thống</div>
                <h3>Ẩm Thực Việt Nam</h3>
                <p>
                    Khám phá những món ăn Việt Nam đậm đà bản sắc,
                    kết hợp nguyên liệu tươi ngon và cách chế biến tinh tế.
                </p>
            </div>
        </div>

        <div class="food-card">
            <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0"
                 alt="Nhà hàng sang trọng" />
            <div class="food-content">
                <div class="food-label">Không gian đẳng cấp</div>
                <h3>Nhà Hàng</h3>
                <p>
                    Không gian dùng bữa thanh lịch, phù hợp cho những
                    bữa ăn cùng gia đình, bạn bè hoặc đối tác.
                </p>
            </div>
        </div>

        <div class="food-card">
            <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307"
                 alt="Bánh ngọt và món tráng miệng" />
            <div class="food-content">
                <div class="food-label">Ngọt ngào mỗi ngày</div>
                <h3>Bánh Ngọt & Tráng Miệng</h3>
                <p>
                    Thưởng thức những món tráng miệng hấp dẫn,
                    mang đến dư vị ngọt ngào sau mỗi bữa ăn.
                </p>
            </div>
        </div>

        <div class="food-card">
            <img src="https://i.pinimg.com/736x/55/64/d6/5564d69417f1a6e67f058646b1e5550c.jpg"
                 alt="Bữa sáng" />
            <div class="food-content">
                <div class="food-label">Khởi đầu ngày mới</div>
                <h3>Bữa Sáng</h3>
                <p>
                    Bắt đầu ngày mới với bữa sáng đa dạng,
                    giúp bạn nạp năng lượng cho hành trình khám phá.
                </p>
            </div>
        </div>

        <div class="food-card">
            <img src="https://i.pinimg.com/736x/a9/22/8d/a9228d18aaa11d94e4ec14f78ca2a2ac.jpg"
                 alt="Đồ uống giải khát" />
            <div class="food-content">
                <div class="food-label">Thư giãn và tận hưởng</div>
                <h3>Đồ Uống</h3>
                <p>
                    Khám phá các loại đồ uống thơm ngon,
                    thích hợp để thư giãn và trò chuyện cùng bạn bè.
                </p>
            </div>
        </div>

        <div class="food-card">
            <img src="https://images.unsplash.com/photo-1547592180-85f173990554"
                 alt="Món ăn đặc sắc" />
            <div class="food-content">
                <div class="food-label">Trải nghiệm đặc biệt</div>
                <h3>Món Ăn Đặc Sắc</h3>
                <p>
                    Tìm hiểu những lựa chọn món ăn nổi bật
                    để làm phong phú thêm trải nghiệm nghỉ dưỡng.
                </p>
            </div>
        </div>

    </section>

    <section class="food-bottom">
        <h2>Thưởng Thức Trọn Vẹn Kỳ Nghỉ</h2>
        <p>
            Liên hệ với chúng tôi để tìm hiểu thêm về nhà hàng,
            thực đơn và các dịch vụ ẩm thực.
        </p>

        <a class="food-button"
           asp-controller="Home"
           asp-action="Contact">Liên hệ ngay</a>
    </section>

</div>
